{
  "name": "queue-management-system",
  "version": "1.0.0",
  "description": "Full-stack smart queue management application with real-time updates and analytics",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('backend/.env') && fs.existsSync('backend/.env.example')) fs.copyFileSync('backend/.env.example', 'backend/.env');\"",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "preseed": "node -e \"const fs=require('fs'); if(!fs.existsSync('backend/.env') && fs.existsSync('backend/.env.example')) fs.copyFileSync('backend/.env.example', 'backend/.env');\"",
    "seed": "cd backend && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "queue-management",
    "token-system",
    "react",
    "nodejs",
    "express",
    "prisma",
    "analytics"
  ],
  "author": "Rohit Kumar",
  "license": "MIT"
}

